# syntax=docker/dockerfile:1

# Single-container image: builds the frontend, then runs nginx + all four
# node bridges (debrid, trakt, external-return, playback) under supervisord.

FROM node:24-alpine AS frontend-builder

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:24-bookworm-slim AS runtime-deps

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts

FROM mwader/static-ffmpeg:7.1 AS ffmpeg

FROM node:24-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends nginx supervisor coreutils ca-certificates \
    && rm -f /etc/nginx/sites-enabled/default \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ffmpeg /ffmpeg /usr/local/bin/ffmpeg
COPY --from=ffmpeg /ffprobe /usr/local/bin/ffprobe
RUN chmod +x /usr/local/bin/ffmpeg /usr/local/bin/ffprobe

WORKDIR /app
COPY --from=runtime-deps /app/node_modules ./node_modules

COPY --from=frontend-builder /app/dist /usr/share/nginx/html
COPY docker/nginx-single.conf /etc/nginx/nginx.conf
COPY nginx/default.single.conf /etc/nginx/conf.d/default.conf

# Browser configuration is written at container start, never baked into layers.
# It is generated under /tmp so the container can stay read-only.
COPY docker/nginx-entrypoint.d/40-nuvio-env.sh /usr/local/bin/nuvio-env.sh
COPY docker/nginx-single.sh /usr/local/bin/nginx-single.sh
RUN sed -i 's#/usr/share/nginx/html/nuvio.env.js#/tmp/nuvio.env.js#' /usr/local/bin/nuvio-env.sh \
    && sed -i 's/\r$//' /usr/local/bin/nuvio-env.sh /usr/local/bin/nginx-single.sh \
    && chmod +x /usr/local/bin/nuvio-env.sh /usr/local/bin/nginx-single.sh

COPY services/debrid-api-bridge ./debrid-api-bridge
COPY services/trakt-auth-bridge ./trakt-auth-bridge
COPY services/external-return-bridge ./external-return-bridge
COPY services/playback-bridge ./playback-bridge

COPY docker/supervisord.single.conf /etc/supervisor/conf.d/supervisord.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "const urls=['http://127.0.0.1:8081/api/debrid/health','http://127.0.0.1:8082/api/trakt/health','http://127.0.0.1:8083/api/external-return/health','http://127.0.0.1:3100/api/playback/health','http://127.0.0.1/'];Promise.all(urls.map((u)=>fetch(u))).then((rs)=>{for(const r of rs)if(!r.ok)process.exit(1);process.exit(0)}).catch(()=>process.exit(1))"

CMD ["supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf", "-n"]